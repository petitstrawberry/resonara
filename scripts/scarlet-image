#!/usr/bin/env bash
# Build audited Resonara artifacts into an explicitly selected Scarlet profile.
set -euo pipefail
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
INSIDE_NIX=0
if [[ "${1:-}" == --inside-nix ]]; then INSIDE_NIX=1; shift; fi
if [[ "${1:-}" == -h || "${1:-}" == --help ]]; then
  cat <<'EOF'
Usage: scripts/scarlet-image <Scarlet checkout> [--profile full|native-desktop] [--replace-image]
Builds and audits the native CLAP host and bundled gain effect, then composes
the selected image. Default profile: full (Debian/Wine).
The explicit native-desktop profile keeps the exact native desktop bundle in
a separate project, with no Debian/Wine, experimental or guest Rust layers.
An existing disk is preserved unless --replace-image is supplied. Replacement
recomposes the guest filesystem: export any guest-created files first.
An existing or edited local overlay is always preserved unless it exactly
matches the overlay generated by this script.
For native-desktop only, RESONARA_SCARLET_VALIDATION_ROOTFS may add files under
/share/resonara-validation. It is unset by default and cannot override binaries.
The project advisory lock coordinates these Resonara wrappers only. Stop any
VM/image builder started with the upstream runner or other tools yourself.
EOF
  exit 0
fi
if [[ $# -lt 1 || ! -d "$1" ]]; then
  printf 'Usage: scripts/scarlet-image <Scarlet checkout> [--profile full|native-desktop] [--replace-image]\n' >&2
  exit 2
fi
SCARLET="$(cd "$1" && pwd)"
shift
PROFILE=full
REPLACE_IMAGE=""
while (($#)); do
  case "$1" in
    --replace-image) REPLACE_IMAGE=--replace-image; shift ;;
    --profile)
      [[ $# -ge 2 ]] || { printf '%s\n' '--profile requires full or native-desktop' >&2; exit 2; }
      PROFILE="$2"; shift 2 ;;
    *) printf 'Unknown option: %s\n' "$1" >&2; exit 2 ;;
  esac
done
case "$PROFILE" in
  full)
    PROJECT="$SCARLET/projects/aarch64-limine-full"
    IMAGE="$PROJECT/.scarlet/images/limine-aarch64-full.img"
    PROFILE_ARTIFACTS="$REPO/artifacts/scarlet"
    ;;
  native-desktop)
    PROJECT="$SCARLET/projects/aarch64-limine-resonara-native"
    IMAGE="$PROJECT/.scarlet/images/limine-aarch64-resonara-native.img"
    PROFILE_ARTIFACTS="$REPO/artifacts/scarlet-native"
    ;;
  *) printf 'Unknown profile: %s\n' "$PROFILE" >&2; exit 2 ;;
esac
if [[ "$PROFILE" == native-desktop && -L "$PROJECT" ]]; then
  printf 'Preserving a symlinked native project directory: %s\n' "$PROJECT" >&2
  exit 2
fi
VALIDATION_ROOTFS="${RESONARA_SCARLET_VALIDATION_ROOTFS:-}"
if [[ -n "$VALIDATION_ROOTFS" ]]; then
  if [[ "$PROFILE" != native-desktop || ! -d "$VALIDATION_ROOTFS" ]]; then
    printf 'Validation rootfs must be an existing directory and requires --profile native-desktop.\n' >&2
    exit 2
  fi
  VALIDATION_ROOTFS="$(cd "$VALIDATION_ROOTFS" && pwd)"
  export RESONARA_SCARLET_VALIDATION_ROOTFS="$VALIDATION_ROOTFS"
fi
for required in flake.nix projects/aarch64-limine-full/scarlet.toml projects/aarch64-limine-full/tools/run_aarch64.sh; do
  if [[ ! -f "$SCARLET/$required" ]]; then
    printf 'Not a supported Scarlet checkout: missing %s\n' "$required" >&2
    exit 2
  fi
done
if [[ -n "${SCARLET_QEMU_QMP:-}" ]] && test -S "$SCARLET_QEMU_QMP"; then
  printf 'QMP socket already exists; inspect and stop the current VM before building: %s\n' "$SCARLET_QEMU_QMP" >&2
  exit 2
fi
if [[ ( -e "$IMAGE" || -L "$IMAGE" ) && -z "$REPLACE_IMAGE" ]]; then
  printf 'Preserving the existing guest disk: %s\nUse --replace-image only after exporting guest-created files.\n' "$IMAGE" >&2
  exit 2
fi
if [[ "$INSIDE_NIX" == 0 ]]; then
  NIX="${RESONARA_NIX:-nix}"
  if ! command -v "$NIX" >/dev/null; then
    printf 'Nix was not found. Install Nix or set RESONARA_NIX to its executable.\n' >&2
    exit 127
  fi
  cd "$SCARLET"
  ARGS=(--inside-nix "$SCARLET" --profile "$PROFILE")
  if [[ -n "$REPLACE_IMAGE" ]]; then ARGS+=("$REPLACE_IMAGE"); fi
  exec "$NIX" --extra-experimental-features 'nix-command flakes' develop --accept-flake-config --no-write-lock-file -c bash "$REPO/scripts/scarlet-image" "${ARGS[@]}"
fi
# FD 9 is shared with scarlet-run when it invokes this builder. The flock is
# associated with that open file description and remains held by the caller.
# Python provides the same Unix flock primitive on Linux and macOS without
# requiring the platform-specific flock command to be installed.
LOCK="$PROJECT/.scarlet/resonara-vm.lock"
if [[ "${RESONARA_SCARLET_LOCK_PROJECT:-}" != "$PROJECT" ]]; then
  mkdir -p "$PROJECT/.scarlet"
  exec 9>>"$LOCK"
fi
python3 - "$LOCK" <<'PY'
import fcntl, os, sys
path = sys.argv[1]
try:
    held, expected = os.fstat(9), os.stat(path)
    if (held.st_dev, held.st_ino) != (expected.st_dev, expected.st_ino):
        raise OSError('inherited descriptor does not match the project lock')
    fcntl.flock(9, fcntl.LOCK_EX | fcntl.LOCK_NB)
except OSError as error:
    raise SystemExit(f'Project is busy or its lock is unavailable: {path}: {error}')
PY
export RESONARA_SCARLET_LOCK_PROJECT="$PROJECT"
# Repeat the state checks under the lock in case another wrapper finished
# creating an image while this process was entering the development shell.
if [[ -n "${SCARLET_QEMU_QMP:-}" ]] && test -S "$SCARLET_QEMU_QMP"; then
  printf 'QMP socket already exists; inspect and stop the current VM before building: %s\n' "$SCARLET_QEMU_QMP" >&2
  exit 2
fi
if [[ ( -e "$IMAGE" || -L "$IMAGE" ) && -z "$REPLACE_IMAGE" ]]; then
  printf 'Preserving the existing guest disk: %s\nUse --replace-image only after exporting guest-created files.\n' "$IMAGE" >&2
  exit 2
fi
if [[ "$PROFILE" == native-desktop ]]; then
  python3 "$REPO/scripts/scarlet-native-project.py" "$SCARLET"
fi
printf 'Selected Scarlet image profile: %s\n' "$PROFILE"
if ! rustc --print target-list | grep -Fx aarch64-unknown-scarlet >/dev/null; then
  printf 'The selected Nix shell does not provide the native Scarlet Rust target.\n' >&2
  exit 2
fi
OVERLAY="$PROJECT/scarlet.local.toml"
MARKER='# Generated by Resonara scripts/scarlet-image'
ARTIFACTS="$PROFILE_ARTIFACTS"
prepare_overlay() {
  python3 - "$PROJECT" "$ARTIFACTS/rootfs" "$OVERLAY" "$MARKER" "$VALIDATION_ROOTFS" "$1" <<'PYOVERLAY'
import json, os, pathlib, sys
project, rootfs, overlay, marker, validation_rootfs, mode = sys.argv[1:]
path = pathlib.Path(overlay)
source = os.path.relpath(rootfs, project)
base = f'{marker}\n\n[[images.rootfs.layers]]\nkind = "copy"\nsource = {json.dumps(source)}\nto = "/"\n'
expected = base
if validation_rootfs:
    root = pathlib.Path(validation_rootfs)
    allowed = root / "share/resonara-validation"
    if not allowed.is_dir():
        raise SystemExit('Validation rootfs must contain share/resonara-validation')
    for item in root.rglob('*'):
        relative = item.relative_to(root)
        allowed_parent = relative in (pathlib.Path('share'), pathlib.Path('share/resonara-validation'))
        allowed_child = pathlib.Path('share/resonara-validation') in relative.parents
        if item.is_symlink() or not (allowed_parent or allowed_child) or not (item.is_dir() or item.is_file()):
            raise SystemExit(f'Validation overlay may contain only ordinary files/directories under /share/resonara-validation: {item}')
    validation_source = os.path.relpath(root, project)
    expected += f'\n[[images.rootfs.layers]]\nkind = "copy"\nsource = {json.dumps(validation_source)}\nto = "/"\n'
# Appending the explicitly requested fixture layer to our exact original overlay
# is allowed. Any user edit or different previous fixture source is preserved.
if path.is_symlink() or (path.exists() and path.read_text() not in (base, expected)):
    raise SystemExit(f'Preserving an existing or edited local overlay. Merge it separately: {path}')
if mode == 'write' and (not path.exists() or path.read_text() != expected):
    path.write_text(expected)
PYOVERLAY
}
prepare_overlay check
cd "$REPO"
TARGET_DIR="${CARGO_TARGET_DIR:-$REPO/target}"
mkdir -p "$TARGET_DIR" "$ARTIFACTS"
TARGET_DIR="$(cd "$TARGET_DIR" && pwd)"
cargo build --locked --manifest-path "$REPO/Cargo.toml" --target-dir "$TARGET_DIR" --target aarch64-unknown-scarlet --release -p resonara
BINARY="$TARGET_DIR/aarch64-unknown-scarlet/release/resonara"
# The native host deliberately imports Scarlet's four loader APIs. Fail closed
# on any additional unresolved symbol or unsupported ELF feature before staging.
python3 "$REPO/crates/resonara-clap/scripts/audit-scarlet-host.py" "$BINARY" \
  --arch aarch64 --json "$ARTIFACTS/native-host-audit.json"
# This builder audits its own native shared object before returning success.
python3 "$REPO/plugins/resonara-gain/build.py" --arch aarch64 \
  --toolchain "$(rustc --print sysroot)" --output "$ARTIFACTS/gain-aarch64"
PLUGIN_STAGING="$ARTIFACTS/gain-aarch64/staging/system/plugins"
for required in resonara-gain.clap resonara-gain.LICENSE.txt; do
  if [[ ! -f "$PLUGIN_STAGING/$required" ]]; then
    printf 'Audited gain-plugin output is missing: %s\n' "$PLUGIN_STAGING/$required" >&2
    exit 2
  fi
done
mkdir -p "$ARTIFACTS/rootfs/bin" "$ARTIFACTS/rootfs/etc/stemd.d/apps" "$ARTIFACTS/rootfs/system/plugins"
install -m 0755 "$BINARY" "$ARTIFACTS/rootfs/bin/resonara"
install -m 0644 "$PLUGIN_STAGING/resonara-gain.clap" "$ARTIFACTS/rootfs/system/plugins/resonara-gain.clap"
install -m 0644 "$PLUGIN_STAGING/resonara-gain.LICENSE.txt" "$ARTIFACTS/rootfs/system/plugins/resonara-gain.LICENSE.txt"
cat > "$ARTIFACTS/rootfs/etc/stemd.d/apps/org.resonara.Resonara.desktop" <<'EOF'
[Desktop Entry]
Name=Resonara
Exec=/bin/resonara
Icon=audio-x-generic
Type=Application
Terminal=false
EOF
prepare_overlay write
sha256sum "$ARTIFACTS/rootfs/bin/resonara" > "$ARTIFACTS/native-binary.sha256"
printf 'Native binary: %s\nAdditive image overlay: %s\n' "$BINARY" "$OVERLAY"
cd "$SCARLET"
if [[ -n "${SCARLET_QEMU_QMP:-}" ]] && test -S "$SCARLET_QEMU_QMP"; then
  printf 'QMP socket appeared during the build; refusing image composition: %s\n' "$SCARLET_QEMU_QMP" >&2
  exit 2
fi
if [[ ( -e "$IMAGE" || -L "$IMAGE" ) && -z "$REPLACE_IMAGE" ]]; then
  printf 'A guest image appeared during the build; preserving it. Explicit --replace-image is required.\n' >&2
  exit 2
fi
if [[ -e "$IMAGE" ]]; then
  printf 'Explicitly replacing the existing guest image; guest filesystem changes will be lost.\n' >&2
fi
cargo scarlet image --project "$PROJECT" --release --locked
printf 'Scarlet image (%s): %s\n' "$PROFILE" "$IMAGE"
