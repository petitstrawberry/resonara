#!/usr/bin/env bash
set -euo pipefail
if [ "$(uname -s)" != Linux ]; then
  printf 'GUI smoke requires Linux/X11. Validate the native macOS window directly.\n' >&2
  exit 1
fi
mkdir -p artifacts
run_dir=$(mktemp -d "$PWD/artifacts/gui-smoke.XXXXXX")
cat > "$run_dir/alsa-test.conf" <<CONFIG
pcm.!default {
  type plug
  slave.pcm {
    type file
    slave.pcm { type null }
    file "$run_dir/playback.raw"
    format "raw"
  }
}
CONFIG
export ALSA_CONFIG_PATH="$run_dir/alsa-test.conf"
"${RESONARA_BIN:-${CARGO_TARGET_DIR:-target}/debug/resonara}" > "$run_dir/gui.log" 2>&1 &
app_pid=$!
trap 'kill "$app_pid" 2>/dev/null || true' EXIT
window=""
for attempt in $(seq 1 100); do
  if ! kill -0 "$app_pid" 2>/dev/null; then cat "$run_dir/gui.log" >&2; exit 1; fi
  window=$(xdotool search --onlyvisible --name '^Resonara$' 2>/dev/null | head -1 || true)
  if [ -n "$window" ]; then break; fi
  sleep 0.1
done
[ -n "$window" ]
xdotool windowfocus --sync "$window"
sleep 3
import -window "$window" "$run_dir/resonara.png"
printf 'Native SGFX window rendered: %s\n' "$window"
key() {
  xdotool key --clearmodifiers "$@"
  sleep 0.25
}
file_dialog() {
  key "$1"
  sleep 0.5
  key ctrl+a
  xdotool type --clearmodifiers --delay 1 "$2"
  key Return
}
wait_file() {
  for attempt in $(seq 1 200); do
    if [ -s "$1" ]; then return 0; fi
    if ! kill -0 "$app_pid" 2>/dev/null; then cat "$run_dir/gui.log" >&2; return 1; fi
    sleep 0.1
  done
  printf 'Timed out waiting for fresh GUI output: %s\n' "$1" >&2
  return 1
}
# Exercise public shortcuts rather than relying on the previous form layout.
# Establish pointer motion before a click, which winit needs for its cursor state.
xdotool mousemove --window "$window" 600 250 click 1
key Home
for step in $(seq 1 5); do key Right; done
key s
key ctrl+d
key m
file_dialog ctrl+i "$PWD/artifacts/smoke.wav"
sleep 2
file_dialog ctrl+s "$run_dir/session.resonara.json"
wait_file "$run_dir/session.resonara.json"
file_dialog ctrl+e "$run_dir/mix.wav"
wait_file "$run_dir/mix.wav"
sleep 1
key Home
key space
wait_file "$run_dir/playback.raw"
sleep 0.3
key space
import -window "$window" "$run_dir/resonara-edited.png"
python3 - "$run_dir" <<'PYTEST'
import json
import sys
from pathlib import Path
run=Path(sys.argv[1])
p=json.loads((run/'session.resonara.json').read_text())
assert len(p['tracks'])==5, f"Expected import+duplicate: {len(p['tracks'])} tracks"
assert len(p['tracks'][0]['clips'])==2, 'Split did not execute'
assert p['tracks'][1]['mute'], 'Mute did not execute'
assert p['tracks'][4]['name']=='smoke', 'WAV import did not execute'
b=(run/'mix.wav').read_bytes()
assert b[:4]==b'RIFF' and len(b)>1000, 'No exported WAV'
playback=(run/'playback.raw').read_bytes()
assert playback and any(playback), 'GUI Play did not produce nonzero audio'
print('GUI actions verified: split, duplicate, mute, WAV import, project save, WAV export, nonzero playback')
print(f'Fresh verification artifacts: {run}')
PYTEST
if ! kill -0 "$app_pid" 2>/dev/null; then cat "$run_dir/gui.log" >&2; exit 1; fi
kill "$app_pid"
wait "$app_pid" || true
